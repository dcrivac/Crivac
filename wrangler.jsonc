{
  // crivac.com: the portfolio build (dist/) plus a small Worker script.
  // Deployed by .github/workflows/deploy.yml on every push to main.
  "name": "crivac-site",
  "account_id": "28515e02ec873cc40086abc34c2a3d2f",
  "main": "workers/site.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before matching assets, so www.crivac.com/ and its files
    // get the redirect too (by default an asset match skips the Worker).
    "run_worker_first": true
  },
  // www.crivac.com only redirects to crivac.com (see workers/site.js).
  "routes": [
    { "pattern": "crivac.com", "custom_domain": true },
    { "pattern": "www.crivac.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
